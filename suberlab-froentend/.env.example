# Superlab frontend API configuration
# Copy to .env.local and adjust as needed.

# Primary Laravel API base (used first for all requests)
VITE_API_BASE_URL=https://portal.mysuperlab.in/api/v1

# Set to "true" only for offline/demo development — loads testDatabase.js when API is unreachable
VITE_ALLOW_MOCK_FALLBACK=false
